# Copy to .env and fill in. `docker compose` reads it automatically.

# The organizer password for /host and /admin. Make it long; guests never need it.
PINPOINT_ADMIN_TOKEN=change-me-to-something-long

# Only used by docker-compose.caddy.yml: the public hostname (DNS A record -> your VPS).
PINPOINT_DOMAIN=svatba.kaffi.dev
