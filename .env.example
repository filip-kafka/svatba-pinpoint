# Copy to .env and fill in. `docker compose` reads it automatically.

# The organizer password for /host and /admin. Make it long; guests never need it.
PINPOINT_ADMIN_TOKEN=change-me-to-something-long

# Map. Leave both empty for the default: OpenFreeMap vector map (free, no key, fast).
# Another vector style, e.g. https://tiles.openfreemap.org/styles/bright
PINPOINT_MAP_STYLE=
# Or CARTO Voyager raster tiles. Free key (no account needed): https://carto.com/basemaps/apikey/
PINPOINT_CARTO_KEY=

# Port on the VPS (localhost only) that your reverse proxy forwards to. Change it if 8000
# is taken - Portainer uses 8000 by default.
PINPOINT_PORT=8000

# Only used by docker-compose.caddy.yml: the public hostname (DNS A record -> your VPS).
PINPOINT_DOMAIN=svatba.kaffi.dev
